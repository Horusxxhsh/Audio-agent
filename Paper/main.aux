\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Dual-modal retrieval pipeline with uncertainty-aware fusion. The system retrieves candidates from both text and audio knowledge bases, estimates retrieval uncertainty for each modality, and fuses results using dynamic weights that down-weight unreliable modalities.}}{13}{figure.caption.18}\protected@file@percent }
\newlabel{fig:dual_modal_retrieval}{{8}{13}{Dual-modal retrieval pipeline with uncertainty-aware fusion. The system retrieves candidates from both text and audio knowledge bases, estimates retrieval uncertainty for each modality, and fuses results using dynamic weights that down-weight unreliable modalities}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Uncertainty-aware modality fusion mechanism. Retrieval uncertainty is estimated from similarity distributions using entropy, then mapped to fusion weights via exponential decay. This allows the system to automatically down-weight unreliable modalities (e.g., vague text prompts) and rely more on confident modalities.}}{13}{figure.caption.19}\protected@file@percent }
\newlabel{fig:modality_fusion}{{9}{13}{Uncertainty-aware modality fusion mechanism. Retrieval uncertainty is estimated from similarity distributions using entropy, then mapped to fusion weights via exponential decay. This allows the system to automatically down-weight unreliable modalities (e.g., vague text prompts) and rely more on confident modalities}{figure.caption.19}{}}
