\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Impact of neuro-symbolic reasoning ($N=5$). The LLM improves module consistency for both retrieval modes. TRR provides a stronger starting point in this benchmark, resulting in a larger L2 reduction than Text-RAG.}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:llm_enhancement}{{VI}{7}{Impact of neuro-symbolic reasoning ($N=5$). The LLM improves module consistency for both retrieval modes. TRR provides a stronger starting point in this benchmark, resulting in a larger L2 reduction than Text-RAG}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Case study (Dry Funk): module activation profiles of retrieved prototypes. Under this benchmark, the retrieved prototype can contain module-level mismatches. Here, the Text-RAG prototype includes two spurious active modules (Screamer, Phaser), while the TRR prototype includes one (Screamer), illustrating that texture-aware retrieval yields a closer executable neighborhood in $\Theta $ for downstream correction.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:dryfunk_case}{{3}{7}{Case study (Dry Funk): module activation profiles of retrieved prototypes. Under this benchmark, the retrieved prototype can contain module-level mismatches. Here, the Text-RAG prototype includes two spurious active modules (Screamer, Phaser), while the TRR prototype includes one (Screamer), illustrating that texture-aware retrieval yields a closer executable neighborhood in $\Theta $ for downstream correction}{figure.caption.9}{}}
